# BridgeCalle Environment Configuration

# Server Settings
PORT=3000
NODE_ENV=development

# CALL-E API & SDK Credentials
# Get your credentials at https://open.heycall-e.com / CALL-E Account
CALLE_API_KEY=calle_live_sk_your_api_key_here
CALLE_API_URL=https://api.heycall-e.com/v1
CALLE_MCP_ENDPOINT=https://mcp.heycall-e.com/v1

# AI Model Keys (Optional for advanced summary generation)
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Family Notification Credentials (Optional)
TWILIO_ACCOUNT_SID=AC_your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+18005550199

# Demo Mode (Simulates real phone call flow if CALL-E API key is not provided)
DEMO_MODE=true
